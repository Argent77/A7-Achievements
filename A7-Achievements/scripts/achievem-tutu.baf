IF
  Global("ACH_GRANDMASTER","GLOBAL",0)
  OR(21)
    CheckStat(Player1,5,PROFICIENCYBASTARDSWORD)
    CheckStat(Player1,5,PROFICIENCYLONGSWORD)
    CheckStat(Player1,5,PROFICIENCYSHORTSWORD)
    CheckStat(Player1,5,PROFICIENCYAXE)
    CheckStat(Player1,5,PROFICIENCYTWOHANDEDSWORD)
    CheckStat(Player1,5,PROFICIENCYKATANA)
    CheckStat(Player1,5,PROFICIENCYSCIMITARWAKISASHININJATO)
    CheckStat(Player1,5,PROFICIENCYDAGGER)
    CheckStat(Player1,5,PROFICIENCYWARHAMMER)
    CheckStat(Player1,5,PROFICIENCYSPEAR)
    CheckStat(Player1,5,PROFICIENCYHALBERD)
    CheckStat(Player1,5,PROFICIENCYFLAILMORNINGSTAR)
    CheckStat(Player1,5,PROFICIENCYMACE)
    CheckStat(Player1,5,PROFICIENCYQUARTERSTAFF)
    CheckStat(Player1,5,PROFICIENCYCROSSBOW)
    CheckStat(Player1,5,PROFICIENCYLONGBOW)
    CheckStat(Player1,5,PROFICIENCYSHORTBOW)
    CheckStat(Player1,5,PROFICIENCYDART)
    CheckStat(Player1,5,PROFICIENCYSLING)
    CheckStat(Player1,5,PROFICIENCYBLACKJACK)
    CheckStat(Player1,5,EXTRAPROFICIENCY1)
THEN
