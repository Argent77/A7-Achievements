BEGIN @27 // All bonuses at once
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~A7-Achievements.tp2~ 10) @103 // Requires the subcomponent "Achievements reward" to be installed.
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~JackOfAllPlanes.tp2~ 0)  @104 // Requires the mod "Jack Of All Planes" to be installed.
SUBCOMPONENT @20  // Crossmod compatibility with "Jack Of All Planes"
DESIGNATED 27
LABEL ~A7-ACHIEVEMENTS-CROSSMOD-JACK-ALL~

