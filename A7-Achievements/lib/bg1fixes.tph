// Adjustments for Tutu and BGT to detect some of the achievements

// Achievement: ACH_FLYING_BG1
<<<<<<<< .../inlined/A7-Achievements/bg1fixes/ACH_FLYING-global.baf
IF
  Global("BD_ACH_PARTY","GLOBAL",1)
  NumInPartyGT(1)
THEN
  RESPONSE #100
    SetGlobal("BD_ACH_PARTY","GLOBAL",-1)
    Continue()
END
>>>>>>>>
EXTEND_TOP ~baldur.bcs~ ~.../inlined/A7-Achievements/bg1fixes/ACH_FLYING-global.baf~ // UNLESS ~SetGlobal("BD_ACH_PARTY","GLOBAL",-1)~

<<<<<<<< .../inlined/A7-Achievements/bg1fixes/ACH_FLYING.baf
IF
  Global("BD_ACH_PARTY","GLOBAL",0)
  NumInPartyGT(1)
THEN
  RESPONSE #100
    SetGlobal("BD_ACH_PARTY","GLOBAL",-1)
END

IF
  Global("BD_ACH_PARTY","GLOBAL",0)
  !NumInPartyGT(1)
THEN
  RESPONSE #100
    SetGlobal("BD_ACH_PARTY","GLOBAL",1)
END
>>>>>>>>
EXTEND_BOTTOM ~%CoastWay_BCS%.bcs~ ~.../inlined/A7-Achievements/bg1fixes/ACH_FLYING.baf~ // UNLESS ~SetGlobal("BD_ACH_PARTY","GLOBAL",-1)~
EXTEND_BOTTOM ~%HighHedge_BCS%.bcs~ ~.../inlined/A7-Achievements/bg1fixes/ACH_FLYING.baf~ // UNLESS ~SetGlobal("BD_ACH_PARTY","GLOBAL",-1)~

// Achievement: ACH_HE_STARTED_BG1
<<<<<<<< .../inlined/A7-Achievements/bg1fixes/ACH_USE_YOUR.d
ADD_TRANS_ACTION ~%tutu_var%Marl~ BEGIN 13 END BEGIN 0 END ~SetGlobal("ACH_USE_YOUR","GLOBAL",1)~ UNLESS ~"ACH_USE_YOUR"~
>>>>>>>>
COMPILE EVAL ~.../inlined/A7-Achievements/bg1fixes/ACH_USE_YOUR.d~

