// Achievement: ACH_UNPETRIFIED_BG1
<<<<<<<< .../inlined/A7-Achievements/bg1fixes/ACH_UNPETRIFIED.baf
IF
  InMyArea("Tamah")
  Global("Sprite_Is_DeadTamah","GLOBAL",0)
  !StateCheck("Tamah",STATE_STONE_DEATH)
  Global("Tamah_Freed","GLOBAL",1)
THEN
  RESPONSE #100
    SetGlobal("Tamah_Freed","GLOBAL",2)
END

IF
  InMyArea("Tamah")
  StateCheck("Tamah",STATE_STONE_DEATH)
  Global("Tamah_Freed","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobal("Tamah_Freed","GLOBAL",1)
    SetGlobal("Sprite_Is_DeadTamah","GLOBAL",1)
END
>>>>>>>>
EXTEND_BOTTOM ~%MutaminsGarden_BCS%.bcs~ ~.../inlined/A7-Achievements/bg1fixes/ACH_UNPETRIFIED.baf~ // UNLESS ~SetGlobal("Tamah_Freed","GLOBAL",2)~

