  InMyArea("Branwen")
  Global("Sprite_Is_DeadBranwen","GLOBAL",0)
  !StateCheck("Branwen",STATE_STONE_DEATH)
  Global("Branwen_Freed","GLOBAL",1)
THEN
  RESPONSE #100
    SetGlobal("Branwen_Freed","GLOBAL",2)
END

IF
  InMyArea("Branwen")
  StateCheck("Branwen",STATE_STONE_DEATH)
  Global("Branwen_Freed","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobal("Branwen_Freed","GLOBAL",1)
    SetGlobal("Sprite_Is_DeadBranwen","GLOBAL",1)
END
>>>>>>>>
EXTEND_BOTTOM ~%NashkelCarnival_BCS%.bcs~ ~.../inlined/A7-Achievements/bg1fixes/ACH_THE_STONE_CLERIC.baf~ // UNLESS ~SetGlobal("Branwen_Freed","GLOBAL",2)~

