// Achievement: ACH_UNKNOWN_RISKS
COPY_EXISTING ~movie04.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    PATCH_IF (INDEX_BUFFER(~"portal_out_of_spellhold"~) < 0) BEGIN
      SET pos = INDEX_BUFFER(~Entered(~)
      PATCH_IF (pos >= 0) BEGIN
        SET pos = INDEX_BUFFER(~RESPONSE #[0-9]+~ pos)
        SET pos = INDEX_BUFFER(~[%WNL%]~ pos)
        SPRINT line ~%LNL%SetGlobal("portal_out_of_spellhold","GLOBAL",1)~
        SET len = STRING_LENGTH ~%line%~
        INSERT_BYTES pos len
        WRITE_ASCIIE pos ~%line%~ (len)
      END
    END
  END
BUT_ONLY
