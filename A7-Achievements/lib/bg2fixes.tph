// Achievement: ACH_FRIENDS_LIKE_THESE
<<<<<<<< .../inlined/A7-Achievements/bg2fixes/ACH_FRIENDS_LIKE_THESE.baf
IF
  Die()
THEN
  RESPONSE #100
    SetGlobal("yoshimo_killed_spellhold","GLOBAL",1)
    Continue()
END
>>>>>>>>
EXTEND_TOP ~yoshimox.bcs~ ~.../inlined/A7-Achievements/bg2fixes/ACH_FRIENDS_LIKE_THESE.baf~ // UNLESS ~SetGlobal("yoshimo_killed_spellhold","GLOBAL",1)~

// Achievement: ACH_RESTORED
COPY_EXISTING ~spin919.spl~ ~override~
  LPF ADD_SPELL_EFFECT
    INT_VAR
      opcode = 265  // Modify global variable
      target = 2  // Preset target
      timing = 9  // Instant/Permanent
    STR_VAR
      resource = ~j_noweak~
  END
  LPF ADD_SPELL_EFFECT
    INT_VAR
      opcode = 265  // Modify global variable
      target = 2  // Preset target
      parameter1 = 1
      timing = 4  // Delay/Permanent
      duration = 7200
    STR_VAR
      resource = ~j_noweak~
  END
BUT_ONLY

