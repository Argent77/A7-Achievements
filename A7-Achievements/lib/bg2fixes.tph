// Adjustments for BG2 and BGT to detect some of the achievements

// Achievement: ACH_FLYING_BG1
<<<<<<<< .../inlined/A7-Achievements/bg2fixes/ACH_FLYING-global.baf
IF
  Global("BD_ACH_PARTY","GLOBAL",1)
  NumInPartyGT(1)
THEN
  RESPONSE #100
    SetGlobal("BD_ACH_PARTY","GLOBAL",-1)
    Continue()
END
>>>>>>>>
EXTEND_TOP ~baldur.bcs~ ~.../inlined/A7-Achievements/bg2fixes/ACH_FLYING-global.baf~ // UNLESS ~SetGlobal("BD_ACH_PARTY","GLOBAL",-1)~

<<<<<<<< .../inlined/A7-Achievements/bg2fixes/ACH_FLYING.baf
IF
  Global("BD_ACH_PARTY","GLOBAL",0)
  NumInPartyGT(1)
THEN
  RESPONSE #100
    SetGlobal("BD_ACH_PARTY","GLOBAL",-1)
END

IF
  Global("BD_ACH_PARTY","GLOBAL",0)
  !NumInPartyGT(1)
THEN
  RESPONSE #100
    SetGlobal("BD_ACH_PARTY","GLOBAL",1)
END
>>>>>>>>
EXTEND_BOTTOM ~ar0603.bcs~ ~.../inlined/A7-Achievements/bg2fixes/ACH_FLYING.baf~ // UNLESS ~SetGlobal("BD_ACH_PARTY","GLOBAL",-1)~

