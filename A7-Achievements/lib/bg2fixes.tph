// Achievement: ACH_A_DARING_ESCAPE
COPY_EXISTING ~cut01g.bcs~ ~override~
  DECOMPILE_AND_PATCH BEGIN
    PATCH_IF (INDEX_BUFFER(~"bd_ach_daring_escape"~) < 0) BEGIN
      REPLACE_TEXTUALLY ~SetGlobal("CutScene01","AR0700",5)~ ~\0 SetGlobal("bd_ach_daring_escape","global",1)~
    END
  END
BUT_ONLY

